# Runtime role: least privilege, cannot UPDATE/DELETE audit_log
DATABASE_URL="postgresql://app_user:app_user@localhost:5433/app"
# Admin role: migrations, seeds and demo scripts only
ADMIN_DATABASE_URL="postgresql://admin:admin@localhost:5433/app"
# Test database (same roles, separate database)
TEST_DATABASE_URL="postgresql://app_user:app_user@localhost:5433/app_test"
TEST_ADMIN_DATABASE_URL="postgresql://admin:admin@localhost:5433/app_test"
