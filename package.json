    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts",
    "demo": "npm run db:up && npm run db:migrate && npm run db:seed && npm run dev",
    "demo:tamper": "tsx scripts/demo-tamper.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "verify-audit": "tsx scripts/verify-audit.ts",
    "classify": "tsx scripts/classify/classify.ts",
    "test": "tsx scripts/prepare-test-db.ts && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.1.0",
    "next": "15.1.3",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.2",
    "dotenv": "16.4.7",
    "prisma": "6.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
